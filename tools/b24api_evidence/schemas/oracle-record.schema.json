{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/evidence/oracle-record-2.0.json",
  "title": "Qualified evidence oracle",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "lineage_id", "case_id", "original_head_sha", "fixed_1x_sha", "candidate_sha", "skills_corpus_sha", "skills_recipe_tree_sha256", "dataset_plan_content_hash", "manifest_content_hash", "portal_fingerprint", "expected_result_hash", "actual_result_hash", "qualification", "snapshot_requirement", "snapshot_state", "pre_hash", "post_hash", "mutation_retries", "raw_count", "unique_count", "outcome"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"$ref": "#/$defs/uuid"}, "lineage_id": {"$ref": "#/$defs/uuid"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 150},
    "original_head_sha": {"const": "08277c4d921b83b9252177b3e72a21a4c0c86109"}, "fixed_1x_sha": {"const": "82f2d9ddafa50e5229c4191b66b0ad6db4ad4600"},
    "candidate_sha": {"$ref": "#/$defs/sha"}, "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"}, "manifest_content_hash": {"$ref": "#/$defs/sha256"},
    "skills_corpus_sha": {"const": "a353a58fb1de7abf2c81dd86fc7d8ad1caea8f2f"}, "skills_recipe_tree_sha256": {"const": "7c6c83487df9913076f16f1cab8630b065df2250f026c4679871957e51343b66"}, "portal_fingerprint": {"$ref": "#/$defs/sha256"},
    "expected_result_hash": {"$ref": "#/$defs/sha256"}, "actual_result_hash": {"$ref": "#/$defs/sha256"},
    "qualification": {"enum": ["immutable_manifest", "bounded_point_read", "independent_cross_method", "independent_serial_reference", "diagnostic_shared_assumption"]},
    "snapshot_requirement": {"enum": ["traversal_only", "frozen_manifest", "independent_pre_post_oracle"]},
    "snapshot_state": {"enum": ["not_requested", "verified", "unverified", "changed"]},
    "pre_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "post_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "mutation_retries": {"type": "integer", "minimum": 0, "maximum": 3}, "raw_count": {"type": "integer", "minimum": 0}, "unique_count": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["PASS", "FAIL", "ORACLE_SUSPECT", "INCONCLUSIVE", "SKIP"]}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]}, "then": {"properties": {"qualification": {"enum": ["immutable_manifest", "bounded_point_read", "independent_cross_method", "independent_serial_reference"]}}}},
    {"if": {"properties": {"outcome": {"const": "PASS"}, "snapshot_requirement": {"enum": ["frozen_manifest", "independent_pre_post_oracle"]}}, "required": ["outcome", "snapshot_requirement"]}, "then": {"properties": {"snapshot_state": {"const": "verified"}, "pre_hash": {"$ref": "#/$defs/sha256"}, "post_hash": {"$ref": "#/$defs/sha256"}}}},
    {"if": {"properties": {"snapshot_state": {"const": "changed"}}, "required": ["snapshot_state"]}, "then": {"properties": {"outcome": {"enum": ["ORACLE_SUSPECT", "INCONCLUSIVE"]}}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f-]{36}$"}},
  "$comment": "The semantic validator additionally requires equal pre_hash and post_hash for frozen or independent PASS, and persistent churn to be INCONCLUSIVE."
}
