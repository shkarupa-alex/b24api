{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/evidence/evidence-artifact-2.0.json",
  "title": "Bitrix24 evidence operation artifact",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "lineage_id", "portal_fingerprint", "host", "command", "phase", "case_id", "original_head_sha", "fixed_1x_sha", "candidate_sha", "skills_corpus_sha", "skills_recipe_tree_sha256", "dataset_plan_content_hash", "manifest_content_hash", "profile_versions", "plan_versions", "runtime", "started_at", "finished_at", "outcome", "terminal_state", "assurance", "snapshot_requirement", "snapshot_state", "metrics", "controls", "evidence_refs", "safe_violations"],
  "properties": {
    "schema_version": {"const": "2.0"}, "run_id": {"$ref": "#/$defs/uuid"}, "lineage_id": {"$ref": "#/$defs/uuid"},
    "portal_fingerprint": {"$ref": "#/$defs/sha256"}, "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
    "command": {"enum": ["plan", "seed", "verify", "benchmark", "resume", "cleanup", "recover-manifest"]}, "phase": {"type": "string", "maxLength": 100},
    "case_id": {"type": ["string", "null"]},
    "original_head_sha": {"const": "08277c4d921b83b9252177b3e72a21a4c0c86109"}, "fixed_1x_sha": {"const": "82f2d9ddafa50e5229c4191b66b0ad6db4ad4600"},
    "candidate_sha": {"$ref": "#/$defs/sha"}, "skills_corpus_sha": {"const": "a353a58fb1de7abf2c81dd86fc7d8ad1caea8f2f"}, "skills_recipe_tree_sha256": {"const": "7c6c83487df9913076f16f1cab8630b065df2250f026c4679871957e51343b66"}, "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "manifest_content_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "benchmark_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "profile_versions": {"type": "array", "items": {"type": "string"}}, "plan_versions": {"type": "array", "items": {"type": "string"}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["python", "b24api", "httpx"], "properties": {"python": {"type": "string"}, "b24api": {"type": "string"}, "httpx": {"type": "string"}}},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["PASS", "FAIL", "ORACLE_SUSPECT", "INCONCLUSIVE", "SKIP"]}, "terminal_state": {"enum": ["completed", "incomplete", "failed", "cancelled"]},
    "assurance": {"enum": ["oracle_verified", "profile_verified", "caller_asserted"]}, "snapshot_requirement": {"enum": ["traversal_only", "frozen_manifest", "independent_pre_post_oracle"]}, "snapshot_state": {"enum": ["not_requested", "verified", "unverified", "changed"]},
    "metrics": {"oneOf": [{"$ref": "#/$defs/operationMetrics"}, {"$ref": "#/$defs/cleanupMetrics"}, {"$ref": "#/$defs/benchmarkMetrics"}]},
    "controls": {"oneOf": [{"$ref": "#/$defs/benchmarkControls"}, {"type": "null"}]},
    "evidence_refs": {"type": "array", "maxItems": 200, "items": {"type": "string", "maxLength": 200, "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Za-z0-9._/-]+)$", "not": {"pattern": "(?:^/|\\.\\.)"}}},
    "safe_violations": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/violation"}}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]}, "then": {"properties": {"terminal_state": {"const": "completed"}, "safe_violations": {"not": {"contains": {"properties": {"severity": {"const": "blocking"}}, "required": ["severity"]}}}}}},
    {"if": {"properties": {"outcome": {"const": "PASS"}, "snapshot_requirement": {"enum": ["frozen_manifest", "independent_pre_post_oracle"]}}, "required": ["outcome", "snapshot_requirement"]}, "then": {"properties": {"snapshot_state": {"const": "verified"}}}},
    {"if": {"properties": {"command": {"const": "benchmark"}}, "required": ["command"]}, "then": {"required": ["benchmark_plan_content_hash"], "properties": {"case_id": {"type": "string"}, "manifest_content_hash": {"$ref": "#/$defs/sha256"}, "assurance": {"const": "oracle_verified"}, "controls": {"$ref": "#/$defs/benchmarkControls"}, "metrics": {"$ref": "#/$defs/benchmarkMetrics"}}}},
    {"if": {"properties": {"command": {"const": "cleanup"}}, "required": ["command"]}, "then": {"properties": {"metrics": {"$ref": "#/$defs/cleanupMetrics"}}}},
    {"if": {"properties": {"command": {"const": "cleanup"}, "outcome": {"const": "PASS"}}, "required": ["command", "outcome"]}, "then": {"properties": {"metrics": {"properties": {"orphan_count": {"const": 0}, "absence_verified": {"const": true}}, "required": ["orphan_count", "absence_verified"]}}}},
    {"if": {"properties": {"command": {"enum": ["plan", "seed", "verify", "resume", "recover-manifest"]}}, "required": ["command"]}, "then": {"properties": {"controls": {"type": "null"}, "metrics": {"$ref": "#/$defs/operationMetrics"}}}}
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uuid": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "violation": {"type": "object", "additionalProperties": false, "required": ["severity", "code", "message", "field"], "properties": {"severity": {"enum": ["warning", "blocking"]}, "code": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}, "message": {"type": "string", "minLength": 1, "maxLength": 500}, "field": {"type": ["string", "null"]}}},
    "operationMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "http_attempts", "wall_seconds"],
      "properties": {
        "kind": {"const": "operation"}, "http_attempts": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}, "records": {"type": "integer", "minimum": 0}
      }
    },
    "cleanupMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "http_attempts", "wall_seconds", "orphan_count", "absence_verified", "orphan_refs"],
      "properties": {
        "kind": {"const": "operation"}, "http_attempts": {"type": "integer", "minimum": 0},
        "wall_seconds": {"type": "number", "minimum": 0}, "orphan_count": {"type": "integer", "minimum": 0},
        "absence_verified": {"type": "boolean"}, "orphan_refs": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    },
    "benchmarkMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "http_attempts", "logical_pages", "batch_requests", "batch_commands", "time_to_first_row_seconds", "wall_seconds", "server_operating_seconds", "retries", "cooldown_seconds", "buffered_rows_high_water", "rss_delta_bytes", "raw_rows", "unique_rows", "overlap", "duplicates", "shortfall", "overfetch", "reference_failures"],
      "properties": {
        "kind": {"const": "benchmark"}, "http_attempts": {"type": "integer", "minimum": 0},
        "logical_pages": {"type": "integer", "minimum": 0}, "batch_requests": {"type": "integer", "minimum": 0},
        "batch_commands": {"type": "integer", "minimum": 0}, "time_to_first_row_seconds": {"type": ["number", "null"], "minimum": 0},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0}, "server_operating_seconds": {"type": "number", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0}, "cooldown_seconds": {"type": "number", "minimum": 0},
        "buffered_rows_high_water": {"type": "integer", "minimum": 0}, "rss_delta_bytes": {"type": ["integer", "null"]},
        "raw_rows": {"type": "integer", "minimum": 0}, "unique_rows": {"type": "integer", "minimum": 0},
        "overlap": {"type": "integer", "minimum": 0}, "duplicates": {"type": "integer", "minimum": 0},
        "shortfall": {"type": "integer", "minimum": 0}, "overfetch": {"type": "integer", "minimum": 0},
        "reference_failures": {"type": "integer", "minimum": 0}
      }
    },
    "benchmarkControls": {
      "type": "object", "additionalProperties": false,
      "required": ["rtt_before_seconds", "rtt_after_seconds", "operating_before_seconds", "operating_after_seconds", "rtt_ratio", "operating_ratio", "max_rtt_ratio", "max_operating_ratio", "drift_quarantined"],
      "properties": {
        "rtt_before_seconds": {"type": "number", "exclusiveMinimum": 0}, "rtt_after_seconds": {"type": "number", "exclusiveMinimum": 0},
        "operating_before_seconds": {"type": "number", "exclusiveMinimum": 0}, "operating_after_seconds": {"type": "number", "exclusiveMinimum": 0},
        "rtt_ratio": {"type": "number", "minimum": 1}, "operating_ratio": {"type": "number", "minimum": 1},
        "max_rtt_ratio": {"type": "number", "minimum": 1}, "max_operating_ratio": {"type": "number", "minimum": 1},
        "drift_quarantined": {"type": "boolean"}
      }
    }
  },
  "$comment": "Semantic validation enforces metric algebra, finite values, derived drift ratios/quarantine, all benchmark correctness counters, and cleanup absence."
}
