{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/evidence/benchmark-plan-2.0.json",
  "title": "Preregistered normalized benchmark plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "lineage_id", "admission_state", "thresholds_normative", "original_head_sha", "fixed_1x_sha", "candidate_sha", "skills_corpus_sha", "skills_recipe_tree_sha256", "dataset_plan_content_hash", "manifest_content_hash", "instrumentation_review_sha", "controls", "cases"],
  "properties": {
    "schema_version": {"const": "2.0"}, "plan_id": {"$ref": "#/$defs/uuid"}, "lineage_id": {"$ref": "#/$defs/uuid"},
    "admission_state": {"enum": ["draft", "admission_ready"]}, "thresholds_normative": {"type": "boolean"},
    "original_head_sha": {"const": "08277c4d921b83b9252177b3e72a21a4c0c86109"}, "fixed_1x_sha": {"const": "82f2d9ddafa50e5229c4191b66b0ad6db4ad4600"},
    "candidate_sha": {"$ref": "#/$defs/sha"}, "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "skills_corpus_sha": {"const": "a353a58fb1de7abf2c81dd86fc7d8ad1caea8f2f"}, "skills_recipe_tree_sha256": {"const": "7c6c83487df9913076f16f1cab8630b065df2250f026c4679871957e51343b66"},
    "manifest_content_hash": {"$ref": "#/$defs/sha256"}, "instrumentation_review_sha": {"const": "521f0eb7cb107ec948c693496154f94e57dbf7c9"},
    "controls": {"$ref": "#/$defs/controls"}, "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [
    {"if": {"properties": {"admission_state": {"const": "draft"}}, "required": ["admission_state"]}, "then": {"properties": {"thresholds_normative": {"const": false}}}},
    {
      "if": {"properties": {"admission_state": {"const": "admission_ready"}}, "required": ["admission_state"]},
      "then": {
        "properties": {
          "thresholds_normative": {"const": true},
          "controls": {
            "properties": {
              "drift": {
                "properties": {
                  "status": {"const": "preregistered"},
                  "max_rtt_ratio": {"type": "number", "minimum": 1},
                  "max_operating_ratio": {"type": "number", "minimum": 1}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmups", "advisory_runs", "blocking_pairs", "interleaving", "timing_model", "drift"],
      "properties": {
        "warmups": {"type": "integer", "minimum": 1},
        "advisory_runs": {"type": "integer", "minimum": 5},
        "blocking_pairs": {"type": "integer", "minimum": 9},
        "interleaving": {"const": true},
        "timing_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "seconds_per_request"],
          "properties": {
            "kind": {"enum": ["deterministic_request_cost", "measured_wall"]},
            "seconds_per_request": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]}
          },
          "allOf": [
            {"if": {"properties": {"kind": {"const": "deterministic_request_cost"}}, "required": ["kind"]}, "then": {"properties": {"seconds_per_request": {"type": "number", "exclusiveMinimum": 0}}}},
            {"if": {"properties": {"kind": {"const": "measured_wall"}}, "required": ["kind"]}, "then": {"properties": {"seconds_per_request": {"type": "null"}}}}
          ]
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "max_rtt_ratio", "max_operating_ratio"],
          "properties": {
            "status": {"enum": ["preregistered", "tbd_live"]},
            "max_rtt_ratio": {"oneOf": [{"type": "number", "minimum": 1}, {"const": "TBD-LIVE"}]},
            "max_operating_ratio": {"oneOf": [{"type": "number", "minimum": 1}, {"const": "TBD-LIVE"}]}
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "compared_plans", "benefit_gate"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "compared_plans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "benefit_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blocking", "minimum_median_improvement", "paired_95_interval_excludes_parity",
            "maximum_small_p95_ratio", "maximum_server_operating_ratio"
          ],
          "properties": {
            "blocking": {"type": "boolean"},
            "minimum_median_improvement": {"type": "number", "minimum": 0},
            "paired_95_interval_excludes_parity": {"type": "boolean"},
            "maximum_small_p95_ratio": {"type": "number", "minimum": 1},
            "maximum_server_operating_ratio": {"type": "number", "minimum": 1}
          },
          "allOf": [{
            "if": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]},
            "then": {"properties": {
              "minimum_median_improvement": {"minimum": 0.15},
              "paired_95_interval_excludes_parity": {"const": true},
              "maximum_small_p95_ratio": {"maximum": 1.05},
              "maximum_server_operating_ratio": {"maximum": 1.1}
            }}
          }]
        }
      }
    }
  },
  "$comment": "Admission semantic validation additionally requires every case to have a blocking gate and at least two distinct compared plans."
}
