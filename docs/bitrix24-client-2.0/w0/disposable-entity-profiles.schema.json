{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/disposable-entity-profiles-1.0.json",
  "title": "Reviewed disposable Bitrix24 entity profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_set_id", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_set_id": {"const": "w0-disposable-entities-v1"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "method": {"type": "string", "pattern": "^[a-z0-9_.]+$", "maxLength": 100},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entity_family",
        "create_method",
        "read_method",
        "delete_method",
        "marker_field",
        "required_scopes",
        "disposable",
        "cleanup_contract"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$", "maxLength": 100},
        "entity_family": {"type": "string", "pattern": "^[a-z0-9_.-]+$", "maxLength": 100},
        "create_method": {"$ref": "#/$defs/method"},
        "read_method": {"$ref": "#/$defs/method"},
        "delete_method": {"$ref": "#/$defs/method"},
        "marker_field": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 100},
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$", "maxLength": 100}
        },
        "disposable": {"const": true},
        "cleanup_contract": {"const": "exact_id_delete_then_point_read_absence"}
      }
    }
  }
}
