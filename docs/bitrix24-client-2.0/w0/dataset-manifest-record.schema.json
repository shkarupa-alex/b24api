{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/dataset-manifest-record-1.1.json",
  "title": "Append-only Bitrix24 evidence manifest record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "run_id",
    "lineage_id",
    "dataset_plan_content_hash",
    "skills_corpus_sha",
    "skills_recipe_tree_sha256",
    "portal_fingerprint",
    "candidate_sha",
    "namespace",
    "event",
    "cell_id",
    "entity_family",
    "correlation_key",
    "entity_id",
    "marker_hash",
    "request_fingerprint",
    "previous_record_hash",
    "record_hash",
    "recorded_at",
    "safe_error"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "sequence": {"type": "integer", "minimum": 0},
    "run_id": {"$ref": "#/$defs/uuid"},
    "lineage_id": {"$ref": "#/$defs/uuid"},
    "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "skills_corpus_sha": {"$ref": "#/$defs/sha"},
    "skills_recipe_tree_sha256": {"$ref": "#/$defs/sha256"},
    "portal_fingerprint": {"$ref": "#/$defs/sha256"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "namespace": {
      "type": "string",
      "pattern": "^b24api-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 52
    },
    "event": {
      "enum": ["planned", "create_dispatched", "created", "ambiguous", "reconciled", "verified", "delete_dispatched", "deleted", "absence_verified", "orphan"]
    },
    "cell_id": {"$ref": "#/$defs/caseId"},
    "entity_family": {"$ref": "#/$defs/safeText"},
    "correlation_key": {"$ref": "#/$defs/sha256"},
    "entity_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 100}, {"type": "integer"}, {"type": "null"}]},
    "parent_correlation_keys": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
    "marker_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "request_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "previous_record_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "record_hash": {"$ref": "#/$defs/sha256"},
    "recorded_at": {"$ref": "#/$defs/timestamp"},
    "safe_error": {"oneOf": [{"$ref": "#/$defs/safeError"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"event": {"enum": ["create_dispatched", "ambiguous"]}}, "required": ["event"]},
      "then": {"properties": {"request_fingerprint": {"$ref": "#/$defs/sha256"}}}
    },
    {
      "if": {"properties": {"event": {"enum": ["created", "reconciled", "verified", "delete_dispatched", "deleted", "absence_verified", "orphan"]}}, "required": ["event"]},
      "then": {
        "properties": {
          "entity_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 100}, {"type": "integer"}]},
          "marker_hash": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"event": {"const": "delete_dispatched"}}, "required": ["event"]},
      "then": {"properties": {"request_fingerprint": {"$ref": "#/$defs/sha256"}}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "not": {"pattern": "(?:[Rr][Ee][Ss][Tt]/[0-9]+/[A-Za-z0-9_-]{8,}|[?&](?:auth|access_token)=|[Bb]earer[ ]+[A-Za-z0-9._~-]{8,})"}
    },
    "safeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "original_code", "normalized_code", "description", "retryable"],
      "properties": {
        "origin": {"enum": ["rest_module", "batch_command", "http_gateway", "transport", "protocol", "capability", "pagination", "budget", "ambiguous_execution"]},
        "original_code": {"oneOf": [{"$ref": "#/$defs/safeText"}, {"type": "integer"}, {"type": "null"}]},
        "normalized_code": {"oneOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "description": {"oneOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "retryable": {"type": "boolean"}
      }
    },
    "caseId": {
      "enum": ["T-S", "T-M", "T-D", "T-SP", "T-B", "T-ID", "T-OR", "E-OFF", "H-REF", "C-REF", "CRM-I", "CRM-A", "CRM-T", "CRM-NO-ID", "IM-X", "IM-DEEP", "IM-RECENT", "V-SIZE", "S-SHORT", "L-NEST", "SR"]
    }
  }
}
