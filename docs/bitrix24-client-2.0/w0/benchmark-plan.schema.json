{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/benchmark-plan-1.2.json",
  "title": "Preregistered Bitrix24 benchmark plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "lineage_id",
    "admission_state",
    "original_head_sha",
    "fixed_1x_sha",
    "candidate_sha",
    "skills_corpus_sha",
    "skills_recipe_tree_sha256",
    "dataset_plan_content_hash",
    "manifest_content_hash",
    "instrumentation_review_sha",
    "controls",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "plan_id": {"$ref": "#/$defs/uuid"},
    "lineage_id": {"$ref": "#/$defs/uuid"},
    "admission_state": {"enum": ["draft", "admission_ready"]},
    "original_head_sha": {"$ref": "#/$defs/sha"},
    "fixed_1x_sha": {"$ref": "#/$defs/sha"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "skills_corpus_sha": {"$ref": "#/$defs/sha"},
    "skills_recipe_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "manifest_content_hash": {"$ref": "#/$defs/sha256"},
    "instrumentation_review_sha": {"$ref": "#/$defs/sha"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "tool_versions", "warmups", "advisory_runs", "blocking_pairs", "interleaving", "drift"],
      "properties": {
        "python_version": {"type": "string", "pattern": "^3\\.(12|13|14)(?:\\.[0-9]+)?$"},
        "tool_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["b24api", "httpx", "pytest"],
          "properties": {
            "b24api": {"type": "string", "minLength": 1, "maxLength": 50},
            "httpx": {"type": "string", "minLength": 1, "maxLength": 50},
            "pytest": {"type": "string", "minLength": 1, "maxLength": 50}
          }
        },
        "warmups": {"type": "integer", "minimum": 1},
        "advisory_runs": {"type": "integer", "minimum": 5},
        "blocking_pairs": {"type": "integer", "minimum": 9},
        "interleaving": {"const": true},
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "max_rtt_ratio", "max_operating_ratio"],
          "properties": {
            "status": {"enum": ["preregistered", "tbd_live"]},
            "max_rtt_ratio": {"oneOf": [{"type": "number", "minimum": 1}, {"const": "TBD-LIVE"}]},
            "max_operating_ratio": {"oneOf": [{"type": "number", "minimum": 1}, {"const": "TBD-LIVE"}]}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "preregistered"}}, "required": ["status"]},
              "then": {
                "properties": {
                  "max_rtt_ratio": {"type": "number", "minimum": 1},
                  "max_operating_ratio": {"type": "number", "minimum": 1}
                }
              },
              "else": {
                "properties": {
                  "max_rtt_ratio": {"const": "TBD-LIVE"},
                  "max_operating_ratio": {"const": "TBD-LIVE"}
                }
              }
            }
          ]
        }
      }
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "allOf": [
    {
      "if": {"properties": {"admission_state": {"const": "admission_ready"}}, "required": ["admission_state"]},
      "then": {
        "properties": {
          "controls": {
            "properties": {
              "drift": {
                "properties": {
                  "status": {"const": "preregistered"},
                  "max_rtt_ratio": {"type": "number", "minimum": 1},
                  "max_operating_ratio": {"type": "number", "minimum": 1}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:sha256:[0-9a-f]{64}|[A-Za-z0-9._/-]+)$",
      "not": {"pattern": "(?:^/|\\.\\.|[Rr][Ee][Ss][Tt]/[0-9]+/)"}
    },
    "caseId": {
      "enum": ["T-S", "T-M", "T-D", "T-SP", "T-B", "T-ID", "T-OR", "E-OFF", "H-REF", "C-REF", "CRM-I", "CRM-A", "CRM-T", "CRM-NO-ID", "IM-X", "IM-DEEP", "IM-RECENT", "V-SIZE", "S-SHORT", "L-NEST", "SR"]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "dataset_plan_ref", "dataset_plan_content_hash", "compared_plans", "oracle_ref", "oracle_content_hash", "consistency_contract", "correctness_gate", "benefit_gate"],
      "properties": {
        "id": {"$ref": "#/$defs/caseId"},
        "method": {"type": "string", "pattern": "^[a-z0-9_.]+$", "maxLength": 100},
        "dataset_plan_ref": {"$ref": "#/$defs/safeRef"},
        "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
        "compared_plans": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 100}},
        "oracle_ref": {"$ref": "#/$defs/safeRef"},
        "oracle_content_hash": {"$ref": "#/$defs/sha256"},
        "consistency_contract": {"type": "string", "minLength": 1, "maxLength": 300},
        "correctness_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_result_contract", "zero_unresolved_failures", "budget_formula"],
          "properties": {
            "exact_result_contract": {"const": true},
            "zero_unresolved_failures": {"const": true},
            "budget_formula": {"type": "string", "minLength": 1, "maxLength": 300}
          }
        },
        "benefit_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocking", "minimum_median_improvement", "paired_95_interval_excludes_parity", "maximum_small_p95_ratio", "maximum_server_operating_ratio"],
          "properties": {
            "blocking": {"type": "boolean"},
            "minimum_median_improvement": {"type": "number", "minimum": 0},
            "paired_95_interval_excludes_parity": {"type": "boolean"},
            "maximum_small_p95_ratio": {"type": "number", "minimum": 1},
            "maximum_server_operating_ratio": {"type": "number", "minimum": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]},
              "then": {
                "properties": {
                  "minimum_median_improvement": {"type": "number", "minimum": 0.15},
                  "paired_95_interval_excludes_parity": {"const": true},
                  "maximum_small_p95_ratio": {"type": "number", "minimum": 1, "maximum": 1.05},
                  "maximum_server_operating_ratio": {"type": "number", "minimum": 1, "maximum": 1.1}
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"benefit_gate": {"properties": {"blocking": {"const": true}}}}, "required": ["benefit_gate"]},
          "then": {"properties": {"compared_plans": {"minItems": 2}}}
        }
      ]
    }
  }
}
