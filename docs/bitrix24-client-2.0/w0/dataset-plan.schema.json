{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/dataset-plan-1.1.json",
  "title": "Bitrix24 evidence dataset plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lineage_id",
    "original_head_sha",
    "candidate_sha",
    "generator_sha",
    "skills_corpus_sha",
    "skills_recipe_tree_sha256",
    "portal",
    "credential_role",
    "namespace",
    "cells",
    "estimated",
    "cleanup",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "lineage_id": {"$ref": "#/$defs/uuid"},
    "original_head_sha": {"$ref": "#/$defs/sha"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "generator_sha": {"$ref": "#/$defs/sha"},
    "skills_corpus_sha": {"$ref": "#/$defs/sha"},
    "skills_recipe_tree_sha256": {"$ref": "#/$defs/sha256"},
    "portal": {"$ref": "#/$defs/portal"},
    "credential_role": {"enum": ["admin_full", "admin_limited", "employee_full", "employee_limited"]},
    "namespace": {
      "type": "string",
      "pattern": "^b24api-evidence-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 52
    },
    "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
    "estimated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "relationships", "requests", "batch_commands", "duration_seconds"],
      "properties": {
        "entities": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "batch_commands": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feasible", "dependency_order", "absence_verification"],
      "properties": {
        "feasible": {"const": true},
        "dependency_order": {"type": "array", "items": {"$ref": "#/$defs/safeText"}},
        "absence_verification": {"$ref": "#/$defs/safeText"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "live", "allow_writes", "plan_review_sha", "approved_by_user"],
      "properties": {
        "state": {"enum": ["preview", "approved_for_seed"]},
        "live": {"type": "boolean"},
        "allow_writes": {"type": "boolean"},
        "plan_review_sha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "approved_by_user": {"type": "boolean"},
        "approved_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "approved_for_seed"}}, "required": ["state"]},
          "then": {
            "properties": {
              "live": {"const": true},
              "allow_writes": {"const": true},
              "plan_review_sha": {"$ref": "#/$defs/sha"},
              "approved_by_user": {"const": true}
            },
            "required": ["approved_at"]
          },
          "else": {
            "properties": {
              "allow_writes": {"const": false},
              "plan_review_sha": {"type": "null"},
              "approved_by_user": {"const": false}
            },
            "not": {"required": ["approved_at"]}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "not": {"pattern": "(?:[Rr][Ee][Ss][Tt]/[0-9]+/[A-Za-z0-9_-]{8,}|[?&](?:auth|access_token)=|[Bb]earer[ ]+[A-Za-z0-9._~-]{8,})"}
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "fingerprint", "fingerprint_algorithm", "build", "scope_hash"],
      "properties": {
        "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$", "maxLength": 253},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "fingerprint_algorithm": {"const": "hmac-sha256-v1"},
        "build": {"type": ["string", "null"], "maxLength": 100},
        "scope_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_family", "target_count", "marker_field", "create_method", "read_method", "delete_method"],
      "properties": {
        "id": {"$ref": "#/$defs/caseId"},
        "entity_family": {"$ref": "#/$defs/safeText"},
        "target_count": {"type": "integer", "minimum": 0},
        "base_count": {"type": "integer", "minimum": 0},
        "distribution": {"enum": ["boundary", "dense", "uniform_sparse", "clustered_sparse", "skewed", "deleted_id", "reference_graph", "single"]},
        "marker_field": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 100},
        "create_method": {"type": "string", "pattern": "^[a-z0-9_.]+$", "maxLength": 100},
        "read_method": {"type": "string", "pattern": "^[a-z0-9_.]+$", "maxLength": 100},
        "delete_method": {"type": "string", "pattern": "^[a-z0-9_.]+$", "maxLength": 100},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/caseId"}},
        "required_scopes": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$", "maxLength": 100}}
      }
    },
    "caseId": {
      "enum": ["T-S", "T-M", "T-D", "T-SP", "T-B", "T-ID", "T-OR", "E-OFF", "H-REF", "C-REF", "CRM-I", "CRM-A", "CRM-T", "CRM-NO-ID", "IM-X", "IM-DEEP", "IM-RECENT", "V-SIZE", "S-SHORT", "L-NEST", "SR"]
    }
  }
}
