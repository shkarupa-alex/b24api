{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/dataset-plan-1.0.json",
  "title": "Bitrix24 evidence dataset plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lineage_id",
    "original_head_sha",
    "candidate_sha",
    "generator_sha",
    "skills_corpus_sha",
    "portal",
    "credential_role",
    "namespace",
    "cells",
    "estimated",
    "cleanup",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "lineage_id": {"type": "string", "format": "uuid"},
    "original_head_sha": {"$ref": "#/$defs/sha"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "generator_sha": {"$ref": "#/$defs/sha"},
    "skills_corpus_sha": {"$ref": "#/$defs/sha"},
    "portal": {"$ref": "#/$defs/portal"},
    "credential_role": {
      "enum": ["admin_full", "admin_limited", "employee_full", "employee_limited"]
    },
    "namespace": {
      "type": "string",
      "pattern": "^b24api-evidence-[0-9a-f-]{36}$",
      "maxLength": 64
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cell"}
    },
    "estimated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "relationships", "requests", "batch_commands", "duration_seconds"],
      "properties": {
        "entities": {"type": "integer", "minimum": 0},
        "relationships": {"type": "integer", "minimum": 0},
        "requests": {"type": "integer", "minimum": 0},
        "batch_commands": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feasible", "dependency_order", "absence_verification"],
      "properties": {
        "feasible": {"const": true},
        "dependency_order": {"type": "array", "items": {"type": "string"}},
        "absence_verification": {"type": "string", "minLength": 1},
        "known_irreversible_effects": {"type": "array", "maxItems": 0}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "live", "allow_writes", "plan_review_sha", "approved_by_user"],
      "properties": {
        "state": {"enum": ["preview", "approved_for_seed"]},
        "live": {"type": "boolean"},
        "allow_writes": {"type": "boolean"},
        "plan_review_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "approved_by_user": {"type": "boolean"},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "approved_for_seed"}}},
          "then": {
            "properties": {
              "live": {"const": true},
              "allow_writes": {"const": true},
              "plan_review_sha": {"$ref": "#/$defs/sha"},
              "approved_by_user": {"const": true}
            },
            "required": ["approved_at"]
          },
          "else": {
            "properties": {
              "allow_writes": {"const": false},
              "plan_review_sha": {"type": "null"},
              "approved_by_user": {"const": false}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "fingerprint", "build", "scope_hash"],
      "properties": {
        "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build": {"type": ["string", "null"]},
        "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_family", "target_count", "marker_field", "create_method", "read_method", "delete_method"],
      "properties": {
        "id": {
          "enum": ["T-S", "T-M", "T-D", "T-SP", "T-B", "T-ID", "T-OR", "E-OFF", "H-REF", "C-REF", "CRM-I", "CRM-A", "CRM-T", "CRM-NO-ID", "IM-X", "IM-DEEP", "IM-RECENT", "V-SIZE", "S-SHORT", "L-NEST", "SR"]
        },
        "entity_family": {"type": "string", "minLength": 1},
        "target_count": {"type": "integer", "minimum": 0},
        "base_count": {"type": "integer", "minimum": 0},
        "distribution": {"enum": ["boundary", "dense", "uniform_sparse", "clustered_sparse", "skewed", "deleted_id", "reference_graph", "single"]},
        "marker_field": {"type": "string", "minLength": 1},
        "create_method": {"type": "string", "minLength": 1},
        "read_method": {"type": "string", "minLength": 1},
        "delete_method": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "required_scopes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
