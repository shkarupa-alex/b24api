{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/oracle-record-1.1.json",
  "title": "Bitrix24 qualified oracle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "lineage_id",
    "case_id",
    "candidate_sha",
    "skills_corpus_sha",
    "skills_recipe_tree_sha256",
    "dataset_plan_content_hash",
    "manifest_content_hash",
    "portal_fingerprint",
    "qualification",
    "normalization",
    "expected",
    "snapshot",
    "outcome",
    "safe_notes"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "run_id": {"$ref": "#/$defs/uuid"},
    "lineage_id": {"$ref": "#/$defs/uuid"},
    "case_id": {"$ref": "#/$defs/caseId"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "skills_corpus_sha": {"$ref": "#/$defs/sha"},
    "skills_recipe_tree_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_plan_content_hash": {"$ref": "#/$defs/sha256"},
    "manifest_content_hash": {"$ref": "#/$defs/sha256"},
    "portal_fingerprint": {"$ref": "#/$defs/sha256"},
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cross_check", "defects", "visibility_differences", "missing_row_behavior"],
      "properties": {
        "kind": {"enum": ["immutable_manifest", "point_read_enumeration", "cross_method", "serial_reference_loop", "diagnostic_only"]},
        "cross_check": {"$ref": "#/$defs/safeText"},
        "defects": {"type": "array", "items": {"$ref": "#/$defs/safeText"}, "maxItems": 100},
        "visibility_differences": {"type": "array", "items": {"$ref": "#/$defs/safeText"}, "maxItems": 100},
        "missing_row_behavior": {"oneOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_mode", "ordering", "duplicate_semantics"],
      "properties": {
        "identity_mode": {"enum": ["exact_string", "exact_integer", "decimal_string_integer", "composite", "none"]},
        "ordering": {"enum": ["unordered", "ascending", "descending", "input"]},
        "duplicate_semantics": {"enum": ["set", "multiset", "ordered_sequence"]}
      },
      "allOf": [
        {
          "if": {"properties": {"duplicate_semantics": {"const": "ordered_sequence"}}, "required": ["duplicate_semantics"]},
          "then": {"properties": {"ordering": {"enum": ["ascending", "descending", "input"]}}}
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_count", "unique_count", "identity_hash", "multiset_hash", "order_hash"],
      "properties": {
        "raw_count": {"type": "integer", "minimum": 0},
        "unique_count": {"type": "integer", "minimum": 0},
        "identity_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "multiset_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "order_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "state", "pre_hash", "post_hash", "quarantine_attempts"],
      "properties": {
        "requirement": {"enum": ["traversal_only", "frozen_manifest", "independent_pre_post_oracle"]},
        "state": {"enum": ["not_requested", "verified", "unverified", "changed"]},
        "pre_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "post_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "quarantine_attempts": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "outcome": {"enum": ["PASS", "FAIL", "ORACLE_SUSPECT", "INCONCLUSIVE", "SKIP"]},
    "safe_notes": {"type": "array", "items": {"$ref": "#/$defs/safeText"}, "maxItems": 20}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "qualification": {"properties": {"kind": {"not": {"const": "diagnostic_only"}}}},
          "expected": {"properties": {"multiset_hash": {"$ref": "#/$defs/sha256"}}},
          "snapshot": {
            "if": {"properties": {"requirement": {"const": "traversal_only"}}, "required": ["requirement"]},
            "then": {"properties": {"state": {"enum": ["not_requested", "verified", "unverified"]}}},
            "else": {"properties": {"state": {"const": "verified"}}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "normalization": {"properties": {"identity_mode": {"not": {"const": "none"}}}},
          "outcome": {"const": "PASS"}
        },
        "required": ["normalization", "outcome"]
      },
      "then": {"properties": {"expected": {"properties": {"identity_hash": {"$ref": "#/$defs/sha256"}}}}}
    },
    {
      "if": {
        "properties": {
          "normalization": {"properties": {"ordering": {"not": {"const": "unordered"}}}},
          "outcome": {"const": "PASS"}
        },
        "required": ["normalization", "outcome"]
      },
      "then": {"properties": {"expected": {"properties": {"order_hash": {"$ref": "#/$defs/sha256"}}}}}
    },
    {
      "if": {
        "properties": {
          "snapshot": {"properties": {"requirement": {"const": "independent_pre_post_oracle"}}},
          "outcome": {"const": "PASS"}
        },
        "required": ["snapshot", "outcome"]
      },
      "then": {"properties": {"snapshot": {"properties": {"pre_hash": {"$ref": "#/$defs/sha256"}, "post_hash": {"$ref": "#/$defs/sha256"}}}}}
    },
    {
      "if": {
        "properties": {
          "snapshot": {
            "properties": {
              "requirement": {"not": {"const": "traversal_only"}},
              "state": {"const": "changed"}
            },
            "required": ["requirement", "state"]
          }
        },
        "required": ["snapshot"]
      },
      "then": {
        "properties": {
          "outcome": {"const": "INCONCLUSIVE"},
          "snapshot": {"properties": {"quarantine_attempts": {"const": 3}}}
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "safeText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {"pattern": "(?:[Rr][Ee][Ss][Tt]/[0-9]+/[A-Za-z0-9_-]{8,}|[?&](?:auth|access_token)=|[Bb]earer[ ]+[A-Za-z0-9._~-]{8,})"}
    },
    "caseId": {
      "enum": ["T-S", "T-M", "T-D", "T-SP", "T-B", "T-ID", "T-OR", "E-OFF", "H-REF", "C-REF", "CRM-I", "CRM-A", "CRM-T", "CRM-NO-ID", "IM-X", "IM-DEEP", "IM-RECENT", "V-SIZE", "S-SHORT", "L-NEST", "SR"]
    }
  }
}
