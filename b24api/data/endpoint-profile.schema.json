{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b24api.local/schemas/endpoint-profile-1.0.json",
  "title": "b24api endpoint profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "endpoint",
    "method",
    "verified_at",
    "expires_at",
    "applicable_builds",
    "required_scopes",
    "query",
    "plan",
    "identity",
    "page_cap",
    "replay_safety",
    "capabilities",
    "evidence",
    "required_probes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/safe_id"},
    "version": {"type": "integer", "minimum": 1},
    "endpoint": {"$ref": "#/$defs/safe_id"},
    "method": {"$ref": "#/$defs/method"},
    "verified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "applicable_builds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"}
    },
    "required_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"}
    },
    "query": {"$ref": "#/$defs/query"},
    "plan": {"$ref": "#/$defs/plan"},
    "identity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/identity"}]},
    "page_cap": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "replay_safety": {"const": "safe"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "required_probes": {
      "type": "array",
      "items": {"$ref": "#/$defs/probe"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.]{1,200}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 0}
        ]
      }
    },
    "selector": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"type": "integer", "minimum": 0}
        ]
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_paths", "filter_keys", "filter_operators", "order", "selector"],
      "properties": {
        "parameter_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "filter_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "filter_operators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["=", "!", ">", ">=", "<", "<=", "%", "!%"]}
        },
        "order": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "string", "minLength": 1},
              {"enum": ["ASC", "DESC"]}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "selector": {"$ref": "#/$defs/selector"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_path", "filter_key", "order_key", "coercion"],
      "properties": {
        "item_path": {"$ref": "#/$defs/path"},
        "filter_key": {"type": "string", "minLength": 1},
        "order_key": {"type": "string", "minLength": 1},
        "coercion": {"enum": ["exact_string", "exact_integer", "decimal_string_integer"]}
      }
    },
    "common_plan": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["single_response", "offset_sequential", "counted_offset", "keyset", "item_cursor"]
        },
        "identity_requirement": {"enum": ["required", "optional", "composite"]},
        "order_semantics": {"enum": ["unordered", "ascending", "descending", "input"]},
        "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
        "total_semantics": {"enum": ["ignore", "advisory", "filtered_exact", "global"]}
      },
      "required": ["kind", "identity_requirement", "order_semantics", "duplicate_policy", "total_semantics"]
    },
    "single_plan": {
      "allOf": [
        {"$ref": "#/$defs/common_plan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity_requirement",
            "order_semantics",
            "duplicate_policy",
            "total_semantics",
            "reject_continuation",
            "reject_positive_total_over_result"
          ],
          "properties": {
            "kind": {"const": "single_response"},
            "identity_requirement": {"enum": ["required", "optional", "composite"]},
            "order_semantics": {"enum": ["unordered", "ascending", "descending", "input"]},
            "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
            "total_semantics": {"enum": ["ignore", "advisory", "filtered_exact", "global"]},
            "reject_continuation": {"type": "boolean"},
            "reject_positive_total_over_result": {"type": "boolean"}
          }
        }
      ]
    },
    "offset_plan": {
      "allOf": [
        {"$ref": "#/$defs/common_plan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity_requirement",
            "order_semantics",
            "duplicate_policy",
            "total_semantics",
            "offset_path",
            "limit_path",
            "requested_page_size",
            "continuation",
            "terminal",
            "allow_create_controls"
          ],
          "properties": {
            "kind": {"const": "offset_sequential"},
            "identity_requirement": {"enum": ["required", "optional", "composite"]},
            "order_semantics": {"enum": ["unordered", "ascending", "descending", "input"]},
            "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
            "total_semantics": {"enum": ["ignore", "advisory", "filtered_exact", "global"]},
            "offset_path": {"$ref": "#/$defs/path"},
            "limit_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
            "requested_page_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "continuation": {"enum": ["server_next", "server_next_or_observed_count", "observed_count"]},
            "terminal": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["empty_page", "qualified_total", "profile_absent_next", "profile_short_page"]}
            },
            "allow_create_controls": {"type": "boolean"}
          }
        }
      ]
    },
    "counted_plan": {
      "allOf": [
        {"$ref": "#/$defs/common_plan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity_requirement",
            "order_semantics",
            "duplicate_policy",
            "total_semantics",
            "mode",
            "offset_path",
            "limit_path",
            "requested_page_size",
            "fixed_stride",
            "allow_create_controls"
          ],
          "properties": {
            "kind": {"const": "counted_offset"},
            "identity_requirement": {"enum": ["required", "optional", "composite"]},
            "order_semantics": {"enum": ["unordered", "ascending", "descending", "input"]},
            "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
            "total_semantics": {"const": "filtered_exact"},
            "mode": {"const": "sequential_next"},
            "offset_path": {"$ref": "#/$defs/path"},
            "limit_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
            "requested_page_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "fixed_stride": {"type": "null"},
            "allow_create_controls": {"type": "boolean"}
          }
        }
      ]
    },
    "keyset_plan": {
      "allOf": [
        {"$ref": "#/$defs/common_plan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity_requirement",
            "order_semantics",
            "duplicate_policy",
            "total_semantics",
            "direction",
            "filter_path",
            "order_path",
            "limit_path",
            "requested_page_size",
            "start_suppression_path",
            "terminal",
            "allow_create_controls"
          ],
          "properties": {
            "kind": {"const": "keyset"},
            "identity_requirement": {"const": "required"},
            "order_semantics": {"enum": ["ascending", "descending"]},
            "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
            "total_semantics": {"enum": ["ignore", "advisory", "filtered_exact", "global"]},
            "direction": {"enum": ["asc", "desc"]},
            "filter_path": {"$ref": "#/$defs/path"},
            "order_path": {"$ref": "#/$defs/path"},
            "limit_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
            "requested_page_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "start_suppression_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
            "terminal": {"enum": ["empty_confirmation", "profile_short_page"]},
            "allow_create_controls": {"type": "boolean"}
          }
        }
      ]
    },
    "cursor_plan": {
      "allOf": [
        {"$ref": "#/$defs/common_plan"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "identity_requirement",
            "order_semantics",
            "duplicate_policy",
            "total_semantics",
            "cursor_request_path",
            "cursor_item_path",
            "cursor_coercion",
            "direction",
            "cursor_take",
            "limit_path",
            "requested_page_size",
            "terminal",
            "allow_create_controls"
          ],
          "properties": {
            "kind": {"const": "item_cursor"},
            "identity_requirement": {"const": "required"},
            "order_semantics": {"enum": ["unordered", "ascending", "descending"]},
            "duplicate_policy": {"enum": ["error", "report", "allow_declared_multiset"]},
            "total_semantics": {"enum": ["ignore", "advisory", "filtered_exact", "global"]},
            "cursor_request_path": {"$ref": "#/$defs/path"},
            "cursor_item_path": {"$ref": "#/$defs/path"},
            "cursor_coercion": {"enum": ["exact_string", "exact_integer", "decimal_string_integer"]},
            "direction": {"enum": ["asc", "desc"]},
            "cursor_take": {"enum": ["first", "last", "min", "max"]},
            "limit_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
            "requested_page_size": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
            "terminal": {"enum": ["empty_confirmation", "profile_short_page", "profile_cursor_exhausted"]},
            "allow_create_controls": {"type": "boolean"}
          }
        }
      ]
    },
    "plan": {
      "oneOf": [
        {"$ref": "#/$defs/single_plan"},
        {"$ref": "#/$defs/offset_plan"},
        {"$ref": "#/$defs/counted_plan"},
        {"$ref": "#/$defs/keyset_plan"},
        {"$ref": "#/$defs/cursor_plan"}
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset_honored",
        "stable_order",
        "filter_honored",
        "cursor_honored",
        "batch_supported",
        "fixed_page_cap"
      ],
      "properties": {
        "offset_honored": {"type": "boolean"},
        "stable_order": {"type": "boolean"},
        "filter_honored": {"type": "boolean"},
        "cursor_honored": {"type": "boolean"},
        "batch_supported": {"type": "boolean"},
        "fixed_page_cap": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "candidate_sha", "reviewed_at", "expires_at", "review_status"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha": {"$ref": "#/$defs/git_sha1"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "review_status": {"enum": ["accepted", "rejected"]}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "method", "max_rows", "selector", "minimal_select", "within_caller_filter"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/safe_id"},
        "method": {"$ref": "#/$defs/method"},
        "max_rows": {"type": "integer", "minimum": 1, "maximum": 100},
        "selector": {"$ref": "#/$defs/selector"},
        "minimal_select": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 100}
        },
        "within_caller_filter": {"const": true}
      }
    }
  }
}
